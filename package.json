{
  "name": "@miorin/dsh-atlas-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A modular program for differentiable, continuous improvement of the workspace experience.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "scripts/dsh-aggregate.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/verification.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "build": "node scripts/dsh-aggregate.mjs generate .",
    "aggregate": "npm run build",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && npm run check",
    "check": "node scripts/dsh-aggregate.mjs check .",
    "prepublishOnly": "node scripts/dsh-aggregate.mjs verify-release . 1>&2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "@miorin/dsh-workspace-switcher",
        "@miorin/dsh-workspace-file-tree",
        "@miorin/dsh-preview-file-navigation",
        "@miorin/dsh-workspace-list-toggle",
        "@miorin/dsh-session-draft",
        "@miorin/dsh-workspace-title-badge",
        "@miorin/dsh-workspace-default-preset"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-workspace-title-badge": "0.1.0",
    "@miorin/dsh-workspace-default-preset": "0.1.0",
    "@miorin/dsh-workspace-switcher": "0.1.0",
    "@miorin/dsh-workspace-file-tree": "0.1.0",
    "@miorin/dsh-preview-file-navigation": "0.1.0",
    "@miorin/dsh-workspace-list-toggle": "0.1.0",
    "@miorin/dsh-session-draft": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
