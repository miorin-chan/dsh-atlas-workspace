import { readFile } from 'node:fs/promises'
import { createRequire } from 'node:module'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { build } from 'esbuild'
import { isRecord } from './lib/data.mts'

export async function bundleAggregate(): Promise<string> {
  const sourceDir = fileURLToPath(new URL('.', import.meta.url))
  const require = createRequire(import.meta.url)
  const yamlManifest = require.resolve('yaml/package.json')
  const yaml: unknown = JSON.parse(await readFile(yamlManifest, 'utf8'))
  if (!isRecord(yaml) || typeof yaml.version !== 'string') {
    throw new Error('Cannot determine the installed yaml version')
  }
  const license = await readFile(join(dirname(yamlManifest), 'LICENSE'), 'utf8')
  const banner = [
    '/*',
    'Generated by scripts/aggregate/build.mts. Do not edit.',
    `Includes yaml ${yaml.version} (https://github.com/eemeli/yaml) under the ISC license.`,
    '',
    license.trim(),
    '*/',
    // The bundled CommonJS YAML implementation uses Node built-ins.
    'import { createRequire } from "node:module";',
    'const require = createRequire(import.meta.url);',
  ].join('\n')

  const { outputFiles: [bundle] } = await build({
    absWorkingDir: sourceDir,
    entryPoints: ['cli.mts'],
    bundle: true,
    format: 'esm',
    platform: 'node',
    target: 'node18',
    minify: true,
    preserveSymlinks: true,
    write: false,
    banner: { js: banner },
  })
  return bundle.text
}
