{
  "name": "dsh-workspace-atlas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A modular program for differentiable, continuous improvement of the workspace experience.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/verification.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "scripts": {
    "aggregate": "node ../../tools/dsh-aggregate/cli.mjs generate .",
    "check": "node ../../tools/dsh-aggregate/cli.mjs check .",
    "prepack": "node ../../tools/dsh-aggregate/cli.mjs check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "dsh-workspace-welcome-switcher",
        "dsh-workspace-title-badge",
        "dsh-workspace-default-preset"
      ]
    }
  },
  "dependencies": {
    "dsh-workspace-welcome-switcher": "link:../dsh-workspace-welcome-switcher",
    "dsh-workspace-title-badge": "link:../dsh-workspace-title-badge",
    "dsh-workspace-default-preset": "link:../dsh-workspace-default-preset"
  }
}
