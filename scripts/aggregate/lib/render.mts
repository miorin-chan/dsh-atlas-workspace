import { Document } from 'yaml'
import { AggregateError } from './errors.mts'
import type { AggregateRow } from './types.mts'

const HEADER = [
  ' Generated by tools/dsh-aggregate from aggregate.yml. Do not edit by hand.',
  ' Regenerate the patch after editing aggregate.yml.',
]

/**
 * Build the aggregate bundle patch from cloned YAML nodes.
 *
 * Cloning rather than re-serializing a plain object keeps custom tags such as
 * `!!js`, block scalar styles, comments, and quoting choices intact.
 */
export function renderPatch(rows: AggregateRow[]): string {
  if (rows.length === 0) throw new AggregateError('aggregate must insert at least one row')

  const inserted = rows.map(({ row, plugin }) => {
    const clone = row.clone()
    if (!clone.commentBefore) clone.commentBefore = ` ${plugin}`
    return clone
  })

  const doc = new Document([{ insert: inserted }])
  doc.commentBefore = HEADER.join('\n')
  return doc.toString({ lineWidth: 0 })
}
