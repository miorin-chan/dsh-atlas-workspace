{
  "name": "@miorin/dsh-atlas-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A modular program for differentiable, continuous improvement of the workspace experience.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/verification.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "aggregate": "node ../../tools/dsh-aggregate/cli.mjs generate .",
    "check": "node ../../tools/dsh-aggregate/cli.mjs check .",
    "prepack": "node ../../tools/dsh-aggregate/cli.mjs check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "@miorin/dsh-workspace-switcher",
        "@miorin/dsh-workspace-file-tree",
        "@miorin/dsh-preview-file-navigation",
        "@miorin/dsh-workspace-list-toggle",
        "@miorin/dsh-session-draft",
        "@miorin/dsh-workspace-title-badge",
        "@miorin/dsh-workspace-default-preset"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-workspace-title-badge": "link:../dsh-workspace-title-badge",
    "@miorin/dsh-workspace-default-preset": "link:../dsh-workspace-default-preset",
    "@miorin/dsh-workspace-switcher": "link:../dsh-workspace-switcher",
    "@miorin/dsh-workspace-file-tree": "link:../dsh-workspace-file-tree",
    "@miorin/dsh-preview-file-navigation": "link:../dsh-preview-file-navigation",
    "@miorin/dsh-workspace-list-toggle": "link:../dsh-workspace-list-toggle",
    "@miorin/dsh-session-draft": "link:../dsh-session-draft"
  }
}
