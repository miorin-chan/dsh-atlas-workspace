{
  "name": "@miorin/dsh-atlas-workspace",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A modular program for differentiable, continuous improvement of the workspace experience.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/verification.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "scripts": {
    "build": "node ../../tools/dsh-aggregate/src/cli.mts generate .",
    "prepare": "node --input-type=module -e \"import { existsSync } from 'node:fs'; import { execFileSync } from 'node:child_process'; const cli = '../../tools/dsh-aggregate/src/cli.mts'; if (existsSync(cli)) execFileSync(process.execPath, [cli, 'generate', '.'], { stdio: 'inherit' })\" 1>&2",
    "test": "npm run build && npm run check",
    "check": "node ../../tools/dsh-aggregate/src/cli.mts check .",
    "prepublishOnly": "node ../../tools/dsh-aggregate/src/cli.mts verify-release ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-workspace",
      "plugins": [
        "@miorin/dsh-workspace-switcher",
        "@miorin/dsh-preview-file-navigation",
        "@miorin/dsh-workspace-title-badge",
        "@miorin/dsh-workspace-default-preset"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-workspace-title-badge": "0.1.0",
    "@miorin/dsh-workspace-default-preset": "0.1.0",
    "@miorin/dsh-workspace-switcher": "0.1.0",
    "@miorin/dsh-preview-file-navigation": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
